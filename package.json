{
  "name": "oil-gas-escrow",
  "version": "1.0.0",
  "description": "Эскроу-смартконтракт для поставки нефти/газа (Solidity + Hardhat + OpenZeppelin)",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "cross-env REPORT_GAS=true hardhat test",
